# Server-side Gemini key. Never expose this as a VITE_ variable.
GEMINI_API_KEY=""

# APP_URL may be supplied by Google AI Studio in its hosted environment.
APP_URL=""

# Optional public API origin used by Android/web builds when the API is hosted
# separately from the frontend. Leave empty for same-origin local development.
# Example: https://api.example.com
VITE_API_BASE_URL=""

# Comma-separated browser origins allowed to call the API in production.
# Capacitor Android origins are allowed by the server automatically.
CORS_ALLOWED_ORIGINS=""
